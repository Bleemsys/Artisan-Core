{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artisan Workbench",
  "mainBinaryName": "ArtGUI",
  "version": "../package.json",
  "identifier": "org.artisan.workbench",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/sync-version.cjs",
    "beforeBuildCommand": "node scripts/sync-version.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArtGUI \u2014 Artisan Workbench",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "backgroundColor": "#f4f6f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": [
        {
          "identifier": "live-progress",
          "description": "Allow the local main window to receive run and geometry progress events.",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Build and run Artisan workflows",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/artisan/": "artisan/",
      "resources/hdf5/api-ms-win-crt-convert-l1-1-0.dll": "api-ms-win-crt-convert-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-environment-l1-1-0.dll": "api-ms-win-crt-environment-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-filesystem-l1-1-0.dll": "api-ms-win-crt-filesystem-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-heap-l1-1-0.dll": "api-ms-win-crt-heap-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-math-l1-1-0.dll": "api-ms-win-crt-math-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-runtime-l1-1-0.dll": "api-ms-win-crt-runtime-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-stdio-l1-1-0.dll": "api-ms-win-crt-stdio-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-string-l1-1-0.dll": "api-ms-win-crt-string-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-time-l1-1-0.dll": "api-ms-win-crt-time-l1-1-0.dll",
      "resources/hdf5/api-ms-win-crt-utility-l1-1-0.dll": "api-ms-win-crt-utility-l1-1-0.dll",
      "resources/hdf5/hdf5.dll": "hdf5.dll",
      "resources/hdf5/icudt78.dll": "icudt78.dll",
      "resources/hdf5/icuuc78.dll": "icuuc78.dll",
      "resources/hdf5/libcrypto-3-x64.dll": "libcrypto-3-x64.dll",
      "resources/hdf5/libcurl.dll": "libcurl.dll",
      "resources/hdf5/libssh2.dll": "libssh2.dll",
      "resources/hdf5/psl-5.dll": "psl-5.dll",
      "resources/hdf5/szip.dll": "szip.dll",
      "resources/hdf5/vcruntime140.dll": "vcruntime140.dll",
      "resources/hdf5/zlib.dll": "zlib.dll",
      "resources/hdf5/runtime-manifest.json": "hdf5-runtime-manifest.json",
      "resources/hdf5/licenses/": "hdf5-licenses/"
    }
  }
}
