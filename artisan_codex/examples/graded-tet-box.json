{
  "Setup": {
    "Type": "Sample",
    "Sample": {
      "Domain": [
        [
          -0.1,
          6.1
        ],
        [
          -0.1,
          3.1
        ],
        [
          -0.1,
          3.1
        ]
      ],
      "Shape": "Box"
    },
    "Rot": [
      0,
      0,
      0
    ],
    "res": [
      0.025,
      0.025,
      0.025
    ],
    "Padding": 2,
    "onGPU": false,
    "memorylimit": 4294967296,
    "JsonWorkDir": true
  },
  "WorkFlow": {
    "1": {
      "ReadMesh": {
        "MeshID": "Solid",
        "meshfile": "./inputs/box.inp",
        "elem_type": "Triangle"
      }
    },
    "2": {
      "Define_ScalarField_CombineGeometry": {
        "field_id": "CellSize",
        "default_value": 1.0,
        "regions": [
          {
            "name": "Fine",
            "geometry": "./inputs/fine-region.inp",
            "value": 0.4,
            "transition_width": 2.0
          }
        ],
        "overlap": "Minimum"
      }
    },
    "3": {
      "Export": {
        "outfile": "./graded-size.h5",
        "GridFieldIDs": [
          "CellSize"
        ]
      }
    },
    "4": {
      "Gen_TetMesh_SizeField": {
        "mesh_file": "Solid",
        "export_mesh": "TetDomains",
        "size_field": "CellSize",
        "sampling_size": 0.75,
        "hausd": 0.03,
        "surface_tolerance": 0.06,
        "quality_report": "./graded-quality.json"
      }
    },
    "5": {
      "ExportMeshID": {
        "MeshID": "TetDomains",
        "out_meshfile": "./graded-domains.inp",
        "elem_type": "Tet"
      }
    },
    "6": {
      "Define_Lattice": {
        "la_name": "GradedInfill",
        "definition": {
          "type": "ConformalLattice",
          "definition": {
            "meshfile": "TetDomains",
            "la_name": "Icosahedral",
            "k": 0.0
          }
        }
      }
    },
    "7": {
      "Add_Lattice": {
        "la_name": "GradedInfill",
        "size": [
          1,
          1,
          1
        ],
        "thk": 0.04,
        "Rot": [
          0,
          0,
          0
        ],
        "Trans": [
          0,
          0,
          0
        ],
        "Inv": false,
        "Fill": false,
        "Cube_Request": {}
      }
    },
    "8": {
      "Intersect_Geometry": {
        "Name": "Solid",
        "k_factor": 0.0,
        "Paras": {
          "Scale": [
            1,
            1,
            1
          ],
          "Rot": [
            0,
            0,
            0
          ],
          "Trans": [
            0,
            0,
            0
          ]
        },
        "push2GeomField": false
      }
    },
    "9": {
      "Export": {
        "outfile": "./graded-lattice.stl"
      }
    }
  },
  "PostProcess": {
    "CombineMeshes": true,
    "RemovePartitionMeshFile": true,
    "RemoveIsolatedParts": false,
    "ExportLazPts": false,
    "CleanExportedMesh": true
  }
}
