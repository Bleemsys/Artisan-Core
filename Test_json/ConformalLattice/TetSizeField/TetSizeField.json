{
  "Setup": {
    "Type": "Sample",
    "Sample": {
      "Domain": [
        [
          -1.0,
          7.0
        ],
        [
          -1.0,
          4.0
        ],
        [
          -1.0,
          4.0
        ]
      ],
      "Shape": "Box"
    },
    "Geomfile": "",
    "Rot": [
      0.0,
      0.0,
      0.0
    ],
    "res": [
      0.2,
      0.25,
      0.25
    ],
    "Padding": 1,
    "onGPU": false,
    "memorylimit": 1073741824
  },
  "WorkFlow": {
    "1": {
      "ReadMesh": {
        "MeshID": "Solid",
        "meshfile": ".//sample-obj//TetSizeField//solid.inp",
        "elem_type": "Triangle"
      }
    },
    "2": {
      "Define_ScalarField_CombineGeometry": {
        "field_id": "CellSize",
        "default_value": 1.0,
        "regions": [
          {
            "name": "FineRegion",
            "geometry": ".//sample-obj//TetSizeField//fine_region.inp",
            "value": 0.4,
            "transition_width": 2.0
          }
        ],
        "overlap": "Minimum"
      }
    },
    "3": {
      "Export": {
        "outfile": ".//Test_results//TetSizeField.h5",
        "GridFieldIDs": [
          "CellSize"
        ]
      }
    },
    "4": {
      "Gen_TetMesh_SizeField": {
        "mesh_file": "Solid",
        "export_mesh": ".//Test_results//TetSizeField.inp",
        "size_field": "CellSize",
        "sampling_size": 0.75,
        "hausd": 0.03,
        "surface_tolerance": 0.06,
        "hgrad": 1.3,
        "preserve_features": true,
        "feature_angle": 45.0,
        "size_iterations": 3,
        "max_points": 250000,
        "quality_report": ".//Test_results//TetSizeField_quality.json"
      }
    }
  },
  "PostProcess": {
    "CombineMeshes": false,
    "RemovePartitionMeshFile": false,
    "RemoveIsolatedParts": false,
    "ExportLazPts": false
  }
}