{
  "Setup": {
    "Type": "Sample",
    "Sample": {"Domain": [[0, 20], [0, 20], [0, 10]], "Shape": "Box"},
    "Rot": [0, 0, 0],
    "res": [2, 2, 2],
    "Padding": 1,
    "onGPU": false,
    "memorylimit": 1073741824,
    "JsonWorkDir": true
  },
  "WorkFlow": {
    "1": {
      "Gen_MultiBlockHexMesh": {
        "method": "Mapped",
        "blocks": [
          {"id": "base", "bounds": [[0, 10], [0, 10], [0, 10]], "num_elem": [2, 2, 2]},
          {"id": "right", "bounds": [[10, 20], [0, 10], [0, 10]], "num_elem": [3, 2, 2]},
          {"id": "upper", "bounds": [[0, 10], [10, 20], [0, 10]], "num_elem": [4, 3, 2]}
        ],
        "out_meshfile": "LShapeHex",
        "match_intervals": true,
        "max_cells": 250000,
        "quality_report": "./LShape_MultiBlock_quality.json"
      }
    },
    "2": {
      "ExportMeshID": {"MeshID": "LShapeHex", "out_meshfile": "./LShape_MultiBlock.inp", "elem_type": "Hex"}
    }
  },
  "PostProcess": {
    "CombineMeshes": true,
    "RemovePartitionMeshFile": false,
    "RemoveIsolatedParts": false,
    "ExportLazPts": false
  }
}
