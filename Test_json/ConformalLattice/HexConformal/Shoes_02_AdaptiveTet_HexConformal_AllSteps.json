{
  "Setup": {
    "Type": "Geometry",
    "Geomfile": ".//sample-obj//Shore//Shoes_02.stl",
    "Rot": [0.0, 0.0, 0.0],
    "res": [0.4, 0.4, 0.4],
    "Padding": 5,
    "onGPU": false,
    "JsonWorkDir": false,
    "memorylimit": 16106127360
  },
  "WorkFlow": {
    "1": {
      "Gen_TetMesh_Adaptive": {
        "mesh_file": ".//sample-obj//Shore//Shoes_02.stl",
        "export_mesh": ".//Test_results//Shoes_02_adaptive_tet.inp",
        "sampling_size": [12.0, 12.0, 12.0],
        "padding": 24.0,
        "hsiz": 8.0,
        "hmin": 0.0,
        "hmax": 0.0,
        "hausd": 0.2,
        "hgrad": 1.3,
        "angle": 45.0,
        "detect_sharp_edges": false,
        "allow_swaps": true,
        "max_points": 750000,
        "adaptive": true,
        "surface_size": 4.0,
        "feature_size": 2.0,
        "adapt_band": 4.0,
        "adapt_iterations": 8
      }
    },
    "2": {
      "Proc_Mesh_PolyCube": {
        "inp_meshfile": ".//Test_results//Shoes_02_adaptive_tet.inp",
        "out_meshfile": ".//Test_results//Shoes_02_polycube.inp",
        "cube": 500.0,
        "smoothness": 10.0,
        "distortion_angle": 10.0,
        "distortion_volume": 10.0,
        "max_iteration": 200
      }
    },
    "3": {
      "Proc_Mesh_ExtractSurf": {
        "inp_meshfile": ".//Test_results//Shoes_02_polycube.inp",
        "out_meshfile": ".//Test_results//Shoes_02_polycube_exterior.stl",
        "isSplitTris": false,
        "Elem_Type": "Tet"
      }
    },
    "4": {
      "Gen_BasicCartesianHexMesh": {
        "num_elem": [20, 40, 9],
        "x_range": [0.0, 160.0],
        "y_range": [0.0, 320.0],
        "z_range": [0.0, 72.0],
        "ori": [-216.0, -208.0, -88.0],
        "Normal": [0.0, 0.0, 1.0],
        "z_angle": 0.0,
        "Meshfile": ".//Test_results//Shoes_02_polycube_hex.med",
        "Geomfile": ".//Test_results//Shoes_02_polycube_exterior.stl",
        "numPrjLayers": 1,
        "LayerDepth": 8.0,
        "numCoverNodes": 2
      }
    },
    "5": {
      "Proc_Mesh_MappingHexElem": {
        "inp_original_meshfile": ".//Test_results//Shoes_02_polycube.inp",
        "inp_deformed_meshfile": ".//Test_results//Shoes_02_adaptive_tet.inp",
        "inp_Hex_meshfile": ".//Test_results//Shoes_02_polycube_hex.med",
        "out_meshfile": ".//Test_results//Shoes_02_hex_mesh.med"
      }
    },
    "6": {
      "Define_Lattice": {
        "la_name": "Shoes02HexConformal",
        "definition": {
          "type": "ConformalLattice",
          "definition": {
            "meshfile": ".//Test_results//Shoes_02_hex_mesh.med",
            "la_name": "SchwarzPrimitive",
            "ExportFEAMeshFile": "",
            "k": 0.0
          }
        }
      }
    },
    "7": {
      "Add_Lattice": {
        "la_name": "Shoes02HexConformal",
        "size": [8.0, 8.0, 8.0],
        "thk": 0.8,
        "Rot": [0.0, 0.0, 0.0],
        "Trans": [0.0, 0.0, 0.0],
        "Inv": false,
        "Fill": false,
        "Cube_Request": {}
      }
    },
    "8": {
      "Export": {
        "outfile": ".//Test_results//Shoes_02_conformal_HexInfill.stl"
      }
    }
  },
  "PostProcess": {
    "CombineMeshes": true,
    "RemovePartitionMeshFile": false,
    "RemoveIsolatedParts": false,
    "ExportLazPts": false
  }
}
