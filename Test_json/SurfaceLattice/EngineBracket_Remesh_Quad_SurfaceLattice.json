{
  "Setup": {
    "Type": "Geometry",
    "Geomfile": ".//sample-obj//EngineBracket.stl",
    "Rot": [0.0, 0.0, 0.0],
    "res": [0.4, 0.4, 0.4],
    "Padding": 5,
    "onGPU": false,
    "memorylimit": 16106127360,
    "JsonWorkDir": false
  },
  "WorkFlow": {
    "1": {
      "Gen_SurfaceReMesh": {
        "mesh_file": ".//sample-obj//EngineBracket.stl",
        "export_mesh": ".//Test_results//EngineBracket_surface_remeshed.stl",
        "hsiz": 3.0,
        "hmin": 1.0,
        "hmax": 4.0,
        "hausd": 0.05,
        "hgrad": 1.3,
        "angle": 45.0,
        "detect_sharp_edges": true,
        "optimize_only": false,
        "verbose": -1
      }
    },
    "2": {
      "Gen_SimpleQuadMesh": {
        "inp_meshfile": ".//Test_results//EngineBracket_surface_remeshed.stl",
        "out_meshfile": ".//Test_results//EngineBracket_surface_quad.inp",
        "size": [4.0, 4.0, 4.0]
      }
    },
    "3": {
      "Define_Lattice": {
        "la_name": "EngineBracketQuadSurfaceLattice",
        "definition": {
          "type": "MeshLattice",
          "definition": {
            "meshfile": ".//Test_results//EngineBracket_surface_quad.inp",
            "k": 0.0
          }
        }
      }
    },
    "4": {
      "Add_Lattice": {
        "la_name": "EngineBracketQuadSurfaceLattice",
        "size": [4.0, 4.0, 4.0],
        "thk": 1.0,
        "Rot": [0.0, 0.0, 0.0],
        "Trans": [0.0, 0.0, 0.0],
        "Inv": false,
        "Fill": false,
        "Cube_Request": {}
      }
    },
    "5": {
      "Export": {
        "outfile": ".//Test_results//EngineBracket_quad_surface_lattice.stl"
      }
    }
  },
  "PostProcess": {
    "CombineMeshes": true,
    "RemovePartitionMeshFile": false,
    "RemoveIsolatedParts": false,
    "ExportLazPts": false
  }
}
