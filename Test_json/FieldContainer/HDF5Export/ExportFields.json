{
  "Setup": {
    "Type": "Sample",
    "Sample": {"Domain": [[0.0, 4.0], [0.0, 4.0], [0.0, 4.0]], "Shape": "Box"},
    "Geomfile": "",
    "Rot": [0.0, 0.0, 0.0],
    "res": [0.25, 0.25, 0.25],
    "Padding": 2,
    "onGPU": false,
    "memorylimit": 1073741824
  },
  "WorkFlow": {
    "1": {"Add_Lattice": {
      "la_name": "BCCubic", "size": [2.0, 2.0, 2.0], "thk": 0.2,
      "Rot": [0.0, 0.0, 0.0], "Trans": [0.0, 0.0, 0.0],
      "Inv": false, "Fill": true, "Cube_Request": {}
    }},
    "2": {"OP_Fit_GridField": {
      "inp_ptFieldFile": "./Test_json/FieldContainer/FitField/cube_points_sdf.csv",
      "out_gridFieldFile": "SizeField"
    }},
    "3": {"Export": {
      "outfile": "./Test_results/HDF5Export.stl",
      "fieldfile": "./Test_results/HDF5Export.h5",
      "GridFieldIDs": ["SizeField"]
    }},
    "4": {"OP_ExprOperation_GridField": {
      "expression": "SizeField + 10",
      "out_gridFieldFile": "OffsetField"
    }},
    "5": {"Export": {
      "outfile": "./Test_results/HDF5Export_Offset.h5",
      "GridFieldIDs": ["OffsetField"]
    }}
  },
  "PostProcess": {
    "CombineMeshes": true,
    "RemovePartitionMeshFile": true,
    "RemoveIsolatedParts": false,
    "ExportLazPts": false
  }
}
